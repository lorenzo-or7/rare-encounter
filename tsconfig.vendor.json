{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vendor.tsbuildinfo",
    "rootDir": "src/vendor",
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./node_modules/.tmp/vendor-types",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/vendor"]
}
