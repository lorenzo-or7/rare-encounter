{
  "name": "rare-encounter",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:safety": "node scripts/check-repo-safety.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:safety && npm run check:vendor",
    "fonts:setup": "node scripts/setup-fonts.mjs",
    "check:vendor": "node scripts/check-vendor.mjs",
    "audit:calibrate": "vitest run --config vitest.audit.config.ts calibrate",
    "audit:coverage": "vitest run --config vitest.audit.config.ts coverage",
    "build:pages": "tsc -b && vite build --base=/rare-encounter/ && node scripts/pages-404.mjs",
    "preview:pages": "vite preview --base=/rare-encounter/ --port 4174 --strictPort",
    "media:setup": "node scripts/setup-media.mjs",
    "media:verify": "node scripts/verify-media.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
